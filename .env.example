# Copy to .env for local dev (scripts/dev-server.js or `netlify dev`). NEVER commit .env.
# On Netlify set these in Site settings -> Environment variables instead.

# Your personal Bible Brain API key (leave blank to run with clearly-labelled MOCK data)
BIBLE_BRAIN_KEY=

# The passcode you and your wife type to open the app (required; app is locked without it)
ACCESS_PASSCODE=

# Optional: comma-separated ISO 639-3 language codes for the translation picker (default: eng)
# BIBLE_LANGUAGES=eng

# Optional: force mock data even when a key is set
# BIBLE_BRAIN_MOCK=1
